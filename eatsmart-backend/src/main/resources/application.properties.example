# ===== EJEMPLO DE CONFIGURACIÓN =====
# Creo este archivo como 'application.properties'
# 'application.properties' está en .gitignore y NO debe subirse al repositorio.

# ===== Configuración de la aplicación =====
spring.application.name=eatsmart-backend
server.port=8080

# ===== DATASOURCE =====
# Configurar las variables de entorno DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD
spring.datasource.url=jdbc:oracle:thin:@${DB_HOST:localhost}:${DB_PORT:1521}:xe
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=oracle.jdbc.driver.OracleDriver
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=5

# ===== JPA/HIBERNATE =====
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# ===== LOGGING =====
logging.level.root=INFO
logging.level.com.eatsmart=DEBUG

# ===== JWT =====
# Generar un secreto aleatorio de al menos 64 caracteres y configurarlo como variable de entorno JWT_SECRET
jwt.secret=${JWT_SECRET}
jwt.expiration=86400000